{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(icon|apple-icon)",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/:lang/opengraph-image",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/:lang/projects/:slug/opengraph-image",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.itsrob.dev" }],
      "destination": "https://itsrob.dev/:path*",
      "permanent": true
    },
    {
      "source": "/resume",
      "destination": "/en/resume",
      "permanent": true
    },
    {
      "source": "/opengraph-image",
      "destination": "/en/opengraph-image",
      "permanent": true
    },
    {
      "source": "/projects/:slug",
      "destination": "/en/projects/:slug",
      "permanent": true
    },
    {
      "source": "/projects/:slug/opengraph-image",
      "destination": "/en/projects/:slug/opengraph-image",
      "permanent": true
    },
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    }
  ]
}
